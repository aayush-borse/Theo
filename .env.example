# REQUIRED for authentication token signing. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
THEO_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
THEO_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/theo.db
MAX_UPLOAD_MB=100
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
THEO_ALLOW_SELF_REGISTER=false
# Optional model integrations. Model IDs or local model paths; empty means disabled.
THEO_SENTIMENT_MODEL=
THEO_NER_MODEL=
THEO_YOLO_MODEL=
THEO_WHISPER_MODEL=
THEO_WHISPER_DEVICE=cpu
THEO_WHISPER_COMPUTE_TYPE=int8
THEO_VIDEO_SAMPLE_SECONDS=2
THEO_VIDEO_MAX_FRAMES=120
THEO_ENABLE_OCR=false
# Tesseract executable must be installed separately for OCR.
THEO_AUTH_REQUIRED=false
THEO_USE_CELERY=false
THEO_REDIS_URL=redis://localhost:6379/0
THEO_IMAGE_CLASSIFIER_MODEL=
THEO_DIARIZATION_MODEL=
HF_TOKEN=
POSTGRES_PASSWORD=replace-with-a-strong-database-password
THEO_INSTALL_ML=false
THEO_AUTO_MIGRATE=true
