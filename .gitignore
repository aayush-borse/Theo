# ==========================================

# THEO - Git Ignore

# ==========================================

# Environment variables and secrets

.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/
config/secrets.*

# Python

**pycache**/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments

.venv/
venv/
env/
ENV/
virtualenv/

# Python tooling

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Jupyter

.ipynb_checkpoints/

# Databases

*.db
*.sqlite
*.sqlite3
*.db-journal

# Migrations: KEEP migration source files

# Do not ignore Alembic migration scripts.

# Logs

*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# THEO runtime data

data/uploads/
data/processed/
data/artifacts/
data/cache/
data/temp/
data/tmp/
data/exports/
storage/
uploads/
artifacts/
processed/
cache/
temp/
tmp/

# Preserve directory placeholders

!data/.gitkeep
!data/uploads/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep

